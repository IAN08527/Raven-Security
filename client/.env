# Plain `.env`, not `.env.development`: `vite build` (what `npm run tauri
# build` invokes, per src-tauri/tauri.conf.json's beforeBuildCommand) runs
# in "production" mode and only loads `.env` / `.env.production`, never
# `.env.development`. This is a single-machine / LAN-pilot deployment
# (CLAUDE.md rule 6) where the built desktop app talks to the same local
# services as `vite dev` does, so one file covers both.
#
# Local basemap (D6, FR-6.2): the Maharashtra PMTiles extract served by the
# `basemap` service in infra/compose/all-in-one.yml. Loopback only — never
# a third-party tile host. ODbL attribution is rendered by client/src/lib/map.ts
# and must always stay visible.
VITE_BASEMAP_URL=http://localhost:8802/maharashtra.pmtiles
VITE_BASEMAP_URL_BASE=http://localhost:8802
VITE_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors (ODbL)

# Local auth (GoTrue on supabase local). Publishable key only — never
# put the secret/service_role key here, it ships to the browser.
VITE_GOTRUE_URL=http://localhost:54321
VITE_GOTRUE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Raven server (plain HTTP on loopback — TLS unimplemented in this tree,
# see SECURITY_AND_PRIVACY.md section 5; change to https when TLS lands).
VITE_SERVER_URL=http://localhost:8443
