# Rust
/target/
**/target/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Tauri
client/src-tauri/gen/

# Generated TypeScript bindings (D30): derived from server Rust structs
# via `cargo xtask generate-types`, never edited by hand. Regenerate
# after changing any API struct instead of committing the output.
client/src/types/generated/

# Supabase local dev
supabase/.branches
supabase/.temp

# Downloaded datasets (tools/fetch_datasets.py). Licence terms vary per
# dataset and several forbid redistribution; nothing under here ships.
eval/datasets/*
!eval/datasets/.gitkeep

# Model weights and exported engines (STACK.md §5: pulled once and cached
# locally, never committed).
models/*
!models/.gitkeep
*.pt
*.onnx
*.engine

# Local eval tooling binaries (mediamtx, ffmpeg) fetched for S1 throughput
# measurement (M1-T8). Downloaded, never committed.
eval/_bin/

# Local PMTiles basemap extract (D6, FR-6.2: MapLibre over a locally hosted
# PMTiles extract, no third-party tile requests). Pulled once via
# `pmtiles extract` from the planet build and served locally on :8802;
# never committed. ODbL Produced Work, OSM attribution required.
infra/tiles/*
!infra/tiles/.gitkeep
# Offline map glyphs (OpenMapTiles Noto Sans PBF stacks, served locally
# with the basemap; never committed). The PBF files stay ignored; the
# FONTS_LICENCE text file is tracked (required for the tiles-audit row).
# NOTE: git cannot re-include a file inside an excluded directory, so the
# glyphs dir itself is un-excluded first, then its contents re-excluded.
!infra/tiles/glyphs/
infra/tiles/glyphs/*
!infra/tiles/glyphs/FONTS_LICENCE

