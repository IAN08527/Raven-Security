{
  "name": "fir_form_a",
  "description": "Example FIR field map (D18). Bboxes are fractions of page width/height [x, y, w, h] so one map serves 200 and 300 DPI scans. Example configuration, not a measured layout.",
  "fields": [
    {
      "field": "complaint_date",
      "bbox": [0.55, 0.06, 0.35, 0.04],
      "charset": "date",
      "validator": "date",
      "required": true
    },
    {
      "field": "ipc_section",
      "bbox": [0.55, 0.11, 0.2, 0.04],
      "charset": "section",
      "validator": "section_number",
      "required": true
    },
    {
      "field": "complainant_phone",
      "bbox": [0.1, 0.2, 0.35, 0.04],
      "charset": "digits",
      "validator": "phone",
      "required": false
    },
    {
      "field": "narrative",
      "bbox": [0.05, 0.3, 0.9, 0.6],
      "charset": "unconstrained",
      "validator": "none",
      "required": false
    }
  ]
}
